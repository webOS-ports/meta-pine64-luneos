+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+/*
+ * The register map is paged: every register address below is relative to
+ * the page selected through GC02M2_REG_PAGE, and the initialisation sequence
+ * switches pages as it goes. Everything the controls touch lives in page 0.
+ */
+#define GC02M2_REG_PAGE			CCI_REG8(0xfe)
+#define GC02M2_PAGE_0			0x00
+
+#define GC02M2_REG_CHIP_ID		CCI_REG16(0xf0)
+#define GC02M2_CHIP_ID			0x02f0
+
+#define GC02M2_REG_MODE			CCI_REG8(0x3e)
+#define GC02M2_MODE_STANDBY		0x00
+#define GC02M2_MODE_STREAMING		0x90
+
+/* 14 bits, split over 0x03 (high 6 bits) and 0x04 */
+#define GC02M2_REG_EXPOSURE		CCI_REG16(0x03)
+#define GC02M2_EXPOSURE_MIN		4
+#define GC02M2_EXPOSURE_STEP		1
+#define GC02M2_EXPOSURE_MARGIN		4
+#define GC02M2_EXPOSURE_MAX		0x3fff
+
+/* Analogue gain is a step index, digital gain a 10-bit multiplier */
+#define GC02M2_REG_AGAIN		CCI_REG8(0xb6)
+#define GC02M2_REG_DGAIN		CCI_REG16(0xb1)
+#define GC02M2_DGAIN_BASE		1024
+#define GC02M2_GAIN_MIN			0x40
+#define GC02M2_GAIN_MAX			0x286
+#define GC02M2_GAIN_STEP		1
+#define GC02M2_GAIN_DEFAULT		0x80
+
+/* 14 bits, split over 0x41 (high 6 bits) and 0x42 */
+#define GC02M2_REG_VTS			CCI_REG16(0x41)
+#define GC02M2_VTS_MAX			0x3fff
+
+#define GC02M2_REG_FLIP			CCI_REG8(0x17)
+#define GC02M2_FLIP_MIRROR		BIT(0)
+#define GC02M2_FLIP_VERTICAL		BIT(1)
+
+#define GC02M2_XCLK_FREQ		(24 * HZ_PER_MHZ)
+#define GC02M2_LINK_FREQ		(336 * HZ_PER_MHZ)
+#define GC02M2_DATA_LANES		1
+#define GC02M2_RGB_DEPTH		10
+#define GC02M2_MBUS_CODE		MEDIA_BUS_FMT_SRGGB10_1X10
+
+#define GC02M2_NATIVE_WIDTH		1600
+#define GC02M2_NATIVE_HEIGHT		1200
+
+#define GC02M2_SLEEP_US			(2 * USEC_PER_MSEC)
+
+static const char * const gc02m2_supply_name[] = {
+	"dovdd",	/* digital I/O */
+	"avdd",		/* analogue */
+	"dvdd",		/* digital core */
+};
+
+struct gc02m2_reg_list {
+	u32 num_of_regs;
+	const struct cci_reg_sequence *regs;
+};
+
+struct gc02m2_mode {
+	u32 width;
+	u32 height;
+	u32 hts;
+	u32 vts_def;
+	u32 vts_min;
+	u32 exp_def;
+	struct gc02m2_reg_list reg_list;
+};
+
+struct gc02m2 {
+	struct device *dev;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct clk *xclk;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(gc02m2_supply_name)];
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *powerdown_gpio;
+
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *hflip;
+	struct v4l2_ctrl *vflip;
+
+	struct regmap *regmap;
+	unsigned long link_freq_bitmap;
+
+	const struct gc02m2_mode *cur_mode;
+};
+
+static inline struct gc02m2 *to_gc02m2(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct gc02m2, sd);
+}

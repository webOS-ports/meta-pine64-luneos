+		.width = GC02M2_NATIVE_WIDTH,
+		.height = GC02M2_NATIVE_HEIGHT,
+		.hts = 0x0448 * 2,
+		.vts_def = 0x04f4,
+		.vts_min = 0x04f4,
+		.exp_def = 0x0475,
+		.reg_list = {
+			.num_of_regs = ARRAY_SIZE(gc02m2_1600x1200_regs),
+			.regs = gc02m2_1600x1200_regs,
+		},
+	},
+};
+
+/*
+ * Total gain -> analogue gain step. Each entry is the lowest total gain
+ * (in 1/64 units, so 0x40 is 1x) at which the analogue step applies; the
+ * remainder is made up with digital gain.
+ */
+static const struct {
+	u16 total_gain;
+	u8 again;
+} gc02m2_gain_table[] = {
+	{ 64, 0 },  { 96, 1 },  { 127, 2 },  { 157, 3 },
+	{ 198, 4 }, { 227, 5 }, { 259, 6 },  { 287, 7 },
+	{ 318, 8 }, { 356, 9 }, { 392, 10 }, { 420, 11 },
+	{ 451, 12 }, { 480, 13 }, { 513, 14 }, { 646, 15 },
+};
+
+static int gc02m2_page0(struct gc02m2 *gc02m2, int *err)
+{
+	return cci_write(gc02m2->regmap, GC02M2_REG_PAGE, GC02M2_PAGE_0, err);
+}
+
+static int gc02m2_set_gain(struct gc02m2 *gc02m2, u32 total_gain)
+{
+	unsigned int i;
+	u32 dgain;
+	int ret = 0;
+
+	total_gain = clamp_t(u32, total_gain, GC02M2_GAIN_MIN, GC02M2_GAIN_MAX);
+
+	for (i = ARRAY_SIZE(gc02m2_gain_table) - 1; i > 0; i--)
+		if (total_gain >= gc02m2_gain_table[i].total_gain)
+			break;
+
+	dgain = total_gain * GC02M2_DGAIN_BASE / gc02m2_gain_table[i].total_gain;
+
+	gc02m2_page0(gc02m2, &ret);
+	cci_write(gc02m2->regmap, GC02M2_REG_AGAIN,
+		  gc02m2_gain_table[i].again, &ret);
+	cci_write(gc02m2->regmap, GC02M2_REG_DGAIN, dgain, &ret);
+
+	return ret;
+}
+
+static int gc02m2_set_flip(struct gc02m2 *gc02m2)
+{
+	u64 val;
+	int ret = 0;
+
+	gc02m2_page0(gc02m2, &ret);
+	ret = cci_read(gc02m2->regmap, GC02M2_REG_FLIP, &val, &ret);
+	if (ret)
+		return ret;
+
+	val &= ~(GC02M2_FLIP_MIRROR | GC02M2_FLIP_VERTICAL);
+	if (gc02m2->hflip->val)
+		val |= GC02M2_FLIP_MIRROR;
+	if (gc02m2->vflip->val)
+		val |= GC02M2_FLIP_VERTICAL;
+
+	return cci_write(gc02m2->regmap, GC02M2_REG_FLIP, val, NULL);
+}
+
+static int gc02m2_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct gc02m2 *gc02m2 = container_of(ctrl->handler, struct gc02m2,
+					     ctrls);
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		s64 max = gc02m2->cur_mode->height + ctrl->val -
+			  GC02M2_EXPOSURE_MARGIN;
+
+		__v4l2_ctrl_modify_range(gc02m2->exposure,
+					 gc02m2->exposure->minimum,
+					 min_t(s64, max, GC02M2_EXPOSURE_MAX),
+					 gc02m2->exposure->step,
+					 gc02m2->exposure->default_value);
+	}
+
+	/* The registers can only be written while the sensor is powered. */
+	if (!pm_runtime_get_if_active(gc02m2->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		gc02m2_page0(gc02m2, &ret);
+		cci_write(gc02m2->regmap, GC02M2_REG_EXPOSURE,
+			  ctrl->val & GC02M2_EXPOSURE_MAX, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = gc02m2_set_gain(gc02m2, ctrl->val);
+		break;
+	case V4L2_CID_VBLANK:
+		gc02m2_page0(gc02m2, &ret);
+		cci_write(gc02m2->regmap, GC02M2_REG_VTS,
+			  (gc02m2->cur_mode->height + ctrl->val) & GC02M2_VTS_MAX,
+			  &ret);
+		break;
+	case V4L2_CID_HFLIP:
+	case V4L2_CID_VFLIP:
+		ret = gc02m2_set_flip(gc02m2);
+		break;
+	default:
+		break;
+	}
+
+	pm_runtime_put(gc02m2->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops gc02m2_ctrl_ops = {
+	.s_ctrl = gc02m2_set_ctrl,
+};
+
+static int gc02m2_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct gc02m2 *gc02m2 = to_gc02m2(sd);
+	int ret;
+
+	gpiod_set_value_cansleep(gc02m2->powerdown_gpio, 1);
+	gpiod_set_value_cansleep(gc02m2->reset_gpio, 1);
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(gc02m2_supply_name),
+				    gc02m2->supplies);
+	if (ret < 0) {
+		dev_err(dev, "failed to enable regulators: %d\n", ret);
+		return ret;
+	}
+
+	ret = clk_prepare_enable(gc02m2->xclk);
+	if (ret < 0) {
+		regulator_bulk_disable(ARRAY_SIZE(gc02m2_supply_name),
+				       gc02m2->supplies);
+		dev_err(dev, "failed to enable xclk: %d\n", ret);
+		return ret;
+	}
+
+	fsleep(GC02M2_SLEEP_US);
+	gpiod_set_value_cansleep(gc02m2->powerdown_gpio, 0);
+	fsleep(GC02M2_SLEEP_US);
+	gpiod_set_value_cansleep(gc02m2->reset_gpio, 0);
+
+	/* 8192 XCLK cycles before the first register access */
+	fsleep(10 * USEC_PER_MSEC);
+
+	return 0;
+}
+
+static int gc02m2_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct gc02m2 *gc02m2 = to_gc02m2(sd);
+
+	gpiod_set_value_cansleep(gc02m2->reset_gpio, 1);
+	gpiod_set_value_cansleep(gc02m2->powerdown_gpio, 1);
+	clk_disable_unprepare(gc02m2->xclk);
+	regulator_bulk_disable(ARRAY_SIZE(gc02m2_supply_name),
+			       gc02m2->supplies);
+
+	return 0;
+}
+
+static int gc02m2_identify(struct gc02m2 *gc02m2)
+{
+	u64 val;
+	int ret = 0;
+
+	gc02m2_page0(gc02m2, &ret);
+	ret = cci_read(gc02m2->regmap, GC02M2_REG_CHIP_ID, &val, &ret);
+	if (ret)
+		return dev_err_probe(gc02m2->dev, ret,
+				     "failed to read chip id\n");
+
+	if (val != GC02M2_CHIP_ID)
+		return dev_err_probe(gc02m2->dev, -ENODEV,
+				     "wrong chip id: 0x%04llx, expected 0x%04x\n",
+				     val, GC02M2_CHIP_ID);
+
+	dev_info(gc02m2->dev, "GC02M2 detected, chip id 0x%04llx\n", val);
+
+	return 0;
+}
+
+static int gc02m2_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+
+	code->code = GC02M2_MBUS_CODE;
+
+	return 0;
+}
+
+static int gc02m2_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(gc02m2_modes))
+		return -EINVAL;
+
+	if (fse->code != GC02M2_MBUS_CODE)
+		return -EINVAL;
+
+	fse->min_width = gc02m2_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = gc02m2_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static void gc02m2_fill_format(const struct gc02m2_mode *mode,
+			       struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->code = GC02M2_MBUS_CODE;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int gc02m2_update_controls(struct gc02m2 *gc02m2,
+				  const struct gc02m2_mode *mode)
+{
+	s64 hblank = mode->hts - mode->width;
+	s64 vblank_def = mode->vts_def - mode->height;
+	s64 vblank_min = mode->vts_min - mode->height;
+	int ret;
+
+	ret = __v4l2_ctrl_modify_range(gc02m2->hblank, hblank, hblank, 1,
+				       hblank);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_modify_range(gc02m2->vblank, vblank_min,
+				       GC02M2_VTS_MAX - mode->height, 1,
+				       vblank_def);
+	if (ret)
+		return ret;
+
+	return __v4l2_ctrl_s_ctrl(gc02m2->vblank, vblank_def);
+}
+
+static int gc02m2_set_format(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state,
+			     struct v4l2_subdev_format *fmt)
+{
+	struct gc02m2 *gc02m2 = to_gc02m2(sd);
+	const struct gc02m2_mode *mode;
+	struct v4l2_mbus_framefmt *format;
+
+	mode = v4l2_find_nearest_size(gc02m2_modes, ARRAY_SIZE(gc02m2_modes),
+				      width, height, fmt->format.width,
+				      fmt->format.height);
+
+	gc02m2_fill_format(mode, &fmt->format);
+	format = v4l2_subdev_state_get_format(state, 0);
+	*format = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY)
+		return 0;
+
+	gc02m2->cur_mode = mode;
+
+	return gc02m2_update_controls(gc02m2, mode);
+}
+
+static int gc02m2_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.top = 0;
+		sel->r.left = 0;
+		sel->r.width = GC02M2_NATIVE_WIDTH;
+		sel->r.height = GC02M2_NATIVE_HEIGHT;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int gc02m2_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			.width = GC02M2_NATIVE_WIDTH,
+			.height = GC02M2_NATIVE_HEIGHT,
+		},
+	};
+
+	gc02m2_set_format(sd, state, &fmt);
+
+	return 0;
+}
+
+static int gc02m2_start_streaming(struct gc02m2 *gc02m2)
+{
+	const struct gc02m2_reg_list *reg_list = &gc02m2->cur_mode->reg_list;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(gc02m2->dev);
+	if (ret < 0)
+		return ret;
+
+	ret = cci_multi_reg_write(gc02m2->regmap, reg_list->regs,
+				  reg_list->num_of_regs, NULL);
+	if (ret) {
+		dev_err(gc02m2->dev, "failed to write mode registers: %d\n",
+			ret);
+		goto err_rpm_put;
+	}
+
+	ret = __v4l2_ctrl_handler_setup(&gc02m2->ctrls);
+	if (ret)
+		goto err_rpm_put;
+
+	gc02m2_page0(gc02m2, &ret);
+	cci_write(gc02m2->regmap, GC02M2_REG_MODE, GC02M2_MODE_STREAMING,
+		  &ret);
+	if (ret) {
+		dev_err(gc02m2->dev, "failed to start streaming: %d\n", ret);
+		goto err_rpm_put;
+	}
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put(gc02m2->dev);
+	return ret;
+}
+
+static int gc02m2_stop_streaming(struct gc02m2 *gc02m2)
+{
+	int ret = 0;
+
+	gc02m2_page0(gc02m2, &ret);
+	cci_write(gc02m2->regmap, GC02M2_REG_MODE, GC02M2_MODE_STANDBY, &ret);
+	if (ret)
+		dev_err(gc02m2->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put(gc02m2->dev);
+
+	return ret;
+}
+
+static int gc02m2_s_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct gc02m2 *gc02m2 = to_gc02m2(sd);
+	struct v4l2_subdev_state *state;
+	int ret;
+
+	state = v4l2_subdev_lock_and_get_active_state(sd);
+
+	if (enable)
+		ret = gc02m2_start_streaming(gc02m2);
+	else
+		ret = gc02m2_stop_streaming(gc02m2);
+
+	v4l2_subdev_unlock_state(state);
+
+	return ret;
+}
+
+static const struct v4l2_subdev_video_ops gc02m2_video_ops = {
+	.s_stream = gc02m2_s_stream,
+};
+
+static const struct v4l2_subdev_pad_ops gc02m2_pad_ops = {
+	.enum_mbus_code = gc02m2_enum_mbus_code,
+	.enum_frame_size = gc02m2_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = gc02m2_set_format,
+	.get_selection = gc02m2_get_selection,
+};
+
+static const struct v4l2_subdev_ops gc02m2_subdev_ops = {
+	.video = &gc02m2_video_ops,
+	.pad = &gc02m2_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops gc02m2_internal_ops = {
+	.init_state = gc02m2_init_state,
+};
+
+static int gc02m2_get_regulators(struct device *dev, struct gc02m2 *gc02m2)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(gc02m2_supply_name); i++)
+		gc02m2->supplies[i].supply = gc02m2_supply_name[i];
+
+	return devm_regulator_bulk_get(dev, ARRAY_SIZE(gc02m2_supply_name),
+				       gc02m2->supplies);
+}
+
+static int gc02m2_parse_fwnode(struct gc02m2 *gc02m2)
+{
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct device *dev = gc02m2->dev;
+	struct fwnode_handle *endpoint;
+	int ret;
+
+	endpoint = fwnode_graph_get_endpoint_by_id(dev_fwnode(dev), 0, 0,
+						   FWNODE_GRAPH_ENDPOINT_NEXT);
+	if (!endpoint)
+		return dev_err_probe(dev, -EINVAL, "missing endpoint node\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &bus_cfg);
+	if (ret) {
+		dev_err_probe(dev, ret, "parsing endpoint node failed\n");
+		goto done;
+	}
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != GC02M2_DATA_LANES) {
+		ret = dev_err_probe(dev, -EINVAL,
+				    "only %u data lane is supported\n",
+				    GC02M2_DATA_LANES);
+		goto done;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       gc02m2_link_freq_menu_items,
+				       ARRAY_SIZE(gc02m2_link_freq_menu_items),
+				       &gc02m2->link_freq_bitmap);
+
+done:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+	fwnode_handle_put(endpoint);
+	return ret;
+}
+
+static u64 gc02m2_to_pixel_rate(u32 f_index)
+{
+	u64 pixel_rate = gc02m2_link_freq_menu_items[f_index] * 2 *
+			 GC02M2_DATA_LANES;
+
+	return div_u64(pixel_rate, GC02M2_RGB_DEPTH);
+}
+
+static int gc02m2_init_controls(struct gc02m2 *gc02m2)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&gc02m2->sd);
+	const struct gc02m2_mode *mode = &gc02m2_modes[0];
+	const struct v4l2_ctrl_ops *ops = &gc02m2_ctrl_ops;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl_handler *ctrl_hdlr = &gc02m2->ctrls;
+	s64 exposure_max, hblank;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(ctrl_hdlr, 9);
+	if (ret)
+		return ret;
+
+	gc02m2->hflip = v4l2_ctrl_new_std(ctrl_hdlr, ops, V4L2_CID_HFLIP,
+					  0, 1, 1, 0);
+	gc02m2->vflip = v4l2_ctrl_new_std(ctrl_hdlr, ops, V4L2_CID_VFLIP,
+					  0, 1, 1, 0);
+	v4l2_ctrl_cluster(2, &gc02m2->hflip);
+
+	gc02m2->link_freq = v4l2_ctrl_new_int_menu(ctrl_hdlr, ops,
+					V4L2_CID_LINK_FREQ,
+					ARRAY_SIZE(gc02m2_link_freq_menu_items) - 1,
+					0, gc02m2_link_freq_menu_items);
+	if (gc02m2->link_freq)
+		gc02m2->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	gc02m2->pixel_rate = v4l2_ctrl_new_std(ctrl_hdlr, ops,
+					       V4L2_CID_PIXEL_RATE, 0,
+					       gc02m2_to_pixel_rate(0), 1,
+					       gc02m2_to_pixel_rate(0));
+
+	gc02m2->vblank = v4l2_ctrl_new_std(ctrl_hdlr, ops, V4L2_CID_VBLANK,
+					   mode->vts_min - mode->height,
+					   GC02M2_VTS_MAX - mode->height, 1,
+					   mode->vts_def - mode->height);
+
+	hblank = mode->hts - mode->width;
+	gc02m2->hblank = v4l2_ctrl_new_std(ctrl_hdlr, ops, V4L2_CID_HBLANK,
+					   hblank, hblank, 1, hblank);
+	if (gc02m2->hblank)
+		gc02m2->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(ctrl_hdlr, ops, V4L2_CID_ANALOGUE_GAIN,
+			  GC02M2_GAIN_MIN, GC02M2_GAIN_MAX, GC02M2_GAIN_STEP,
+			  GC02M2_GAIN_DEFAULT);
+
+	exposure_max = mode->vts_def - GC02M2_EXPOSURE_MARGIN;
+	gc02m2->exposure = v4l2_ctrl_new_std(ctrl_hdlr, ops,
+					     V4L2_CID_EXPOSURE,
+					     GC02M2_EXPOSURE_MIN, exposure_max,
+					     GC02M2_EXPOSURE_STEP,
+					     mode->exp_def);
+
+	ret = v4l2_fwnode_device_parse(&client->dev, &props);
+	if (ret)
+		goto error_ctrls;
+
+	ret = v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, ops, &props);
+	if (ret)
+		goto error_ctrls;
+
+	if (ctrl_hdlr->error) {
+		ret = ctrl_hdlr->error;
+		goto error_ctrls;
+	}
+
+	gc02m2->sd.ctrl_handler = ctrl_hdlr;
+
+	return 0;
+
+error_ctrls:
+	v4l2_ctrl_handler_free(ctrl_hdlr);
+	return ret;
+}
+
+static int gc02m2_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct gc02m2 *gc02m2;
+	int ret;
+
+	gc02m2 = devm_kzalloc(dev, sizeof(*gc02m2), GFP_KERNEL);
+	if (!gc02m2)
+		return -ENOMEM;
+
+	gc02m2->dev = dev;
+
+	ret = gc02m2_parse_fwnode(gc02m2);
+	if (ret)
+		return ret;
+
+	gc02m2->regmap = devm_cci_regmap_init_i2c(client, 8);
+	if (IS_ERR(gc02m2->regmap))
+		return dev_err_probe(dev, PTR_ERR(gc02m2->regmap),
+				     "failed to init CCI\n");
+
+	gc02m2->xclk = devm_v4l2_sensor_clk_get_legacy(dev, NULL, true,
+						       GC02M2_XCLK_FREQ);
+	if (IS_ERR(gc02m2->xclk))
+		return dev_err_probe(dev, PTR_ERR(gc02m2->xclk),
+				     "failed to get xclk\n");
+
+	ret = gc02m2_get_regulators(dev, gc02m2);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	gc02m2->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(gc02m2->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(gc02m2->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	gc02m2->powerdown_gpio = devm_gpiod_get_optional(dev, "powerdown",
+							 GPIOD_OUT_HIGH);
+	if (IS_ERR(gc02m2->powerdown_gpio))
+		return dev_err_probe(dev, PTR_ERR(gc02m2->powerdown_gpio),
+				     "failed to get powerdown gpio\n");
+
+	v4l2_i2c_subdev_init(&gc02m2->sd, client, &gc02m2_subdev_ops);
+	gc02m2->sd.internal_ops = &gc02m2_internal_ops;
+	gc02m2->cur_mode = &gc02m2_modes[0];
+
+	/* Power up once to make sure the sensor is really there. */
+	ret = gc02m2_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = gc02m2_identify(gc02m2);
+	gc02m2_power_off(dev);
+	if (ret)
+		return ret;
+
+	ret = gc02m2_init_controls(gc02m2);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to init controls\n");
+
+	gc02m2->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	gc02m2->pad.flags = MEDIA_PAD_FL_SOURCE;
+	gc02m2->sd.dev = dev;
+	gc02m2->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+
+	ret = media_entity_pads_init(&gc02m2->sd.entity, 1, &gc02m2->pad);
+	if (ret < 0) {
+		dev_err_probe(dev, ret, "could not register media entity\n");
+		goto err_ctrl_handler_free;
+	}
+
+	gc02m2->sd.state_lock = gc02m2->ctrls.lock;
+	ret = v4l2_subdev_init_finalize(&gc02m2->sd);
+	if (ret < 0) {
+		dev_err_probe(dev, ret, "v4l2 subdev init error\n");
+		goto err_media_entity_cleanup;
+	}
+
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_idle(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&gc02m2->sd);
+	if (ret < 0) {
+		dev_err_probe(dev, ret, "could not register v4l2 device\n");
+		goto err_rpm;
+	}
+
+	return 0;
+
+err_rpm:
+	pm_runtime_disable(dev);
+	v4l2_subdev_cleanup(&gc02m2->sd);
+err_media_entity_cleanup:
+	media_entity_cleanup(&gc02m2->sd.entity);
+err_ctrl_handler_free:
+	v4l2_ctrl_handler_free(&gc02m2->ctrls);
+	return ret;
+}
+
+static void gc02m2_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct gc02m2 *gc02m2 = to_gc02m2(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&gc02m2->ctrls);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		gc02m2_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct dev_pm_ops gc02m2_pm_ops = {
+	SET_RUNTIME_PM_OPS(gc02m2_power_off, gc02m2_power_on, NULL)
+};
+
+static const struct of_device_id gc02m2_of_match[] = {
+	{ .compatible = "galaxycore,gc02m2" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, gc02m2_of_match);
+
+static struct i2c_driver gc02m2_i2c_driver = {
+	.driver = {
+		.of_match_table = gc02m2_of_match,
+		.pm = &gc02m2_pm_ops,
+		.name = "gc02m2",
+	},
+	.probe = gc02m2_probe,
+	.remove = gc02m2_remove,
+};
+module_i2c_driver(gc02m2_i2c_driver);
+
+MODULE_DESCRIPTION("GalaxyCore GC02M2 image sensor driver");
+MODULE_AUTHOR("Herman van Hazendonk <github.com@herrie.org>");
+MODULE_LICENSE("GPL");

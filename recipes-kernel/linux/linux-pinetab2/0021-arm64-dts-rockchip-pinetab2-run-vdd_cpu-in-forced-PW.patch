From 6112924a768145484d89e2294afd2a48fe9a20eb Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Mon, 28 Sep 2026 18:53:42 +0200
Subject: [PATCH 21/26] arm64: dts: rockchip: pinetab2: run vdd_cpu in forced
 PWM mode

The TCS4525 feeding the CPU cores sees large, fast load steps (NEON work
starting on all four cores) coinciding with DVFS voltage changes, and the
tablet resets under that combination. Keep the regulator in PWM at all
times so it does not have to leave light-load PFM operation in the middle
of a load step.

Upstream-Status: Pending

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
---
 arch/arm64/boot/dts/rockchip/rk3566-pinetab2.dtsi | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3566-pinetab2.dtsi b/arch/arm64/boot/dts/rockchip/rk3566-pinetab2.dtsi
index eb7413d4cb0a..5dec68e025b2 100644
--- a/arch/arm64/boot/dts/rockchip/rk3566-pinetab2.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3566-pinetab2.dtsi
@@ -6,6 +6,7 @@
 #include <dt-bindings/leds/common.h>
 #include <dt-bindings/media/video-interfaces.h>
 #include <dt-bindings/pinctrl/rockchip.h>
+#include <dt-bindings/regulator/fcs,fan53555.h>
 #include <dt-bindings/soc/rockchip,vop2.h>
 #include <dt-bindings/usb/pd.h>
 #include "rk3566.dtsi"
@@ -405,6 +406,7 @@ vdd_cpu: regulator@1c {
 		regulator-name = "vdd_cpu";
 		regulator-min-microvolt = <800000>;
 		regulator-max-microvolt = <1150000>;
+		regulator-initial-mode = <FAN53555_MODE_FORCED_PWM>;
 		regulator-ramp-delay = <2300>;
 		regulator-always-on;
 		regulator-boot-on;
-- 

From: Herman van Hazendonk <github.com@herrie.org>
Date: Fri, 19 Sep 2026 00:00:00 +0200
Subject: [PATCH] arm64: dts: rockchip: pinetab2: describe the front camera

The front GC02M2 sits at 0x37 on the same bus as the rear sensor, shares
CIF_CLKOUT as its master clock, is enabled by CAMERAB_PDN_L (GPIO4_B3 -
the net name is swapped against the connector, see the rear camera), and
drives lane 2 of the D-PHY with the second clock lane. A pin can only be
muxed by one consumer, so CIF_CLKOUT moves from the rear sensor's node to
a pinctrl hog: with it in the rear node the front sensor probed first and
found no clock, and with it in both the second probe failed with -EINVAL.

Mainline has a single CSI-2 receiver with a single input, so only one of
the two sensors can be wired to it at a time; this connects the front
camera through the PHY's upper lane pair and leaves the rear node
described but unlinked. Switching between them at runtime needs the
receiver to grow a second input first.

Upstream-Status: Pending

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
---
diff -ruN dt_a/arch/arm64/boot/dts/rockchip/rk3566-pinetab2.dtsi dt_b/arch/arm64/boot/dts/rockchip/rk3566-pinetab2.dtsi
--- a/arch/arm64/boot/dts/rockchip/rk3566-pinetab2.dtsi	2026-09-18 20:01:07.785268105 +0200
+++ b/arch/arm64/boot/dts/rockchip/rk3566-pinetab2.dtsi	2026-09-18 21:00:41.228801858 +0200
@@ -281,11 +281,22 @@
 	status = "okay";
 };
 
+/*
+ * The two sensors sit on the two halves of the single CSI-2 D-PHY: the rear
+ * OV5648 on lanes 0-1 with the first clock lane, the front GC02M2 on lane 2
+ * with the second clock lane. Mainline has one CSI-2 receiver with one input,
+ * so only one of them can be wired up at a time; this build brings up the
+ * front camera.
+ */
+&csi {
+	phys = <&csi_dphy 1>;
+};
+
 &csi_in {
 	csi_input: endpoint {
 		bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
-		data-lanes = <1 2>;
-		remote-endpoint = <&ov5648_out>;
+		data-lanes = <1>;
+		remote-endpoint = <&gc02m2_out>;
 	};
 };
 
@@ -615,6 +626,8 @@
 	camera@36 {
 		compatible = "ovti,ov5648";
 		reg = <0x36>;
+		/* faces away from the user; the mounting rotation still has to be measured */
+		orientation = <1>;
 		pinctrl-names = "default";
 		/*
 		 * The schematic's net names are swapped with respect to the
@@ -624,7 +637,7 @@
 		 * single master clock shared by both sensors, and nothing
 		 * muxed it onto its pin at all.
 		 */
-		pinctrl-0 = <&cameraf_pdn_l &cameraf_rst_l &cif_clk>;
+		pinctrl-0 = <&cameraf_pdn_l &cameraf_rst_l>;
 
 		clocks = <&cru CLK_CIF_OUT>;
 		assigned-clocks = <&cru CLK_CIF_OUT>;
@@ -656,11 +669,40 @@
 			ov5648_out: endpoint {
 				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
 				data-lanes = <1 2>;
-				remote-endpoint = <&csi_input>;
 				link-frequencies = /bits/ 64 <210000000 168000000>;
 			};
 		};
 	};
+
+	camera@37 {
+		compatible = "galaxycore,gc02m2";
+		reg = <0x37>;
+		/* faces the user; the mounting rotation still has to be measured */
+		orientation = <0>;
+		pinctrl-names = "default";
+		/* CAMERAB_PDN_L is the front sensor's powerdown, see above. */
+		pinctrl-0 = <&camerab_pdn_l>;
+
+		clocks = <&cru CLK_CIF_OUT>;
+		assigned-clocks = <&cru CLK_CIF_OUT>;
+		assigned-clock-rates = <24000000>;
+		power-domains = <&power RK3568_PD_VI>;
+
+		avdd-supply = <&vcc2v8_dvp>;
+		dovdd-supply = <&vcc1v8_dvp>;
+		/* the connector feeds the front sensor's DVDD pin from 1.8 V */
+		dvdd-supply = <&vcc1v8_dvp>;
+		powerdown-gpios = <&gpio4 RK_PB3 GPIO_ACTIVE_LOW>;
+
+		port {
+			gc02m2_out: endpoint {
+				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+				data-lanes = <1>;
+				remote-endpoint = <&csi_input>;
+				link-frequencies = /bits/ 64 <336000000>;
+			};
+		};
+	};
 };
 
 &i2c5 {
@@ -706,6 +748,14 @@
 };
 
 &pinctrl {
+	/*
+	 * CIF_CLKOUT is the master clock of both camera sensors, and a pin
+	 * can only be claimed by one consumer, so mux it here rather than in
+	 * either sensor node.
+	 */
+	pinctrl-names = "default";
+	pinctrl-0 = <&cif_clk>;
+
 	camerab {
 		camerab_pdn_l: camerab-pdn-l {
 			rockchip,pins = <4 RK_PB3 RK_FUNC_GPIO &pcfg_pull_none>;
diff -ruN dt_a/arch/arm64/boot/dts/rockchip/rk356x-base.dtsi dt_b/arch/arm64/boot/dts/rockchip/rk356x-base.dtsi
--- a/arch/arm64/boot/dts/rockchip/rk356x-base.dtsi	2026-09-18 20:01:07.786126812 +0200
+++ b/arch/arm64/boot/dts/rockchip/rk356x-base.dtsi	2026-09-18 20:01:07.804906466 +0200
@@ -646,7 +646,7 @@
 			     <GIC_SPI 9 IRQ_TYPE_LEVEL_HIGH>;
 		interrupt-names = "err1", "err2";
 		clocks = <&cru PCLK_CSI2HOST1>;
-		phys = <&csi_dphy>;
+		phys = <&csi_dphy 0>;
 		power-domains = <&power RK3568_PD_VI>;
 		resets = <&cru SRST_P_CSI2HOST1>;
 		status = "disabled";
@@ -1875,7 +1875,7 @@
 		reg = <0x0 0xfe870000 0x0 0x10000>;
 		clocks = <&cru PCLK_MIPICSIPHY>;
 		clock-names = "pclk";
-		#phy-cells = <0>;
+		#phy-cells = <1>;
 		resets = <&cru SRST_P_MIPICSIPHY>;
 		reset-names = "apb";
 		rockchip,grf = <&grf>;

From: Herman van Hazendonk <github.com@herrie.org>
Date: Fri, 19 Sep 2026 00:00:00 +0200
Subject: [PATCH] phy: rockchip: inno-csidphy: support the rk3568 split-mode lane pair

The RK3568 CSI-2 D-PHY can run split: lanes 0-1 with the first clock lane
and lanes 2-3 with the second one, each serving a different sensor. The
driver only ever enabled lanes from 0 up with the first clock lane, so a
sensor wired to the upper pair - the PineTab 2 front camera, on lane 2 with
clock lane 1 - could not be received at all.

Let an optional phy cell select the pair. For the upper pair the data lanes
are enabled at bit offset 4 of the lane-enable register, their settle and
calibration registers are the n=2,3 blocks the driver already computes, the
second clock lane's live one block further (0x3e0/0x3e8), and the GRF is
told to run split mode with the upper pair routed to VICAP - VI_CON0 bits
6-7 and 10, VI_CON1 bits 7, 11 and 12, as the vendor PHY driver programs
them - and the PHY itself is put into dual mode through bit 6 of the
digital-reset register, without which the upper pair never delivers a
frame. With no cell, or cell 0, behaviour is unchanged.

Upstream-Status: Pending

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
---
diff -ruN ph_a/drivers/phy/rockchip/phy-rockchip-inno-csidphy.c ph_b/drivers/phy/rockchip/phy-rockchip-inno-csidphy.c
--- a/drivers/phy/rockchip/phy-rockchip-inno-csidphy.c	2026-09-18 20:00:37.533443984 +0200
+++ b/drivers/phy/rockchip/phy-rockchip-inno-csidphy.c	2026-09-18 20:27:30.668254318 +0200
@@ -48,6 +48,8 @@
 #define CSIDPHY_CTRL_DIG_RST			0x80
 #define CSIDPHY_CTRL_DIG_RST_UNDEFINED		0x1e
 #define CSIDPHY_CTRL_DIG_RST_RESET		BIT(0)
+/* rk3568: run the two lane pairs from separate clock lanes */
+#define CSIDPHY_CTRL_DIG_RST_DUAL_MODE		BIT(6)
 
 /* offset after ths_settle_offset */
 #define CSIDPHY_CLK_THS_SETTLE			0
@@ -57,6 +59,12 @@
 /* offset after calib_offset */
 #define CSIDPHY_CLK_CALIB_EN			0
 #define CSIDPHY_LANE_CALIB_EN(n)		(((n) + 1) * 0x80)
+/*
+ * In split mode the upper lane pair has its own clock lane, whose settle and
+ * calibration registers sit right after those of data lane 3.
+ */
+#define CSIDPHY_CLK1_THS_SETTLE			(5 * 0x80)
+#define CSIDPHY_CLK1_CALIB_EN			(5 * 0x80)
 #define CSIDPHY_CALIB_EN			BIT(7)
 
 /* Configure the count time of the THS-SETTLE by protocol. */
@@ -85,6 +93,12 @@
 	GRF_DPHY_CSIPHY_FORCERXMODE,
 	GRF_DPHY_CSIPHY_CLKLANE_EN,
 	GRF_DPHY_CSIPHY_DATALANE_EN,
+	/* rk3568 split mode: upper lane pair with its own clock lane */
+	GRF_DPHY_CSIPHY_CLKLANE1_EN,
+	GRF_DPHY_CSIPHY_DATALANE1_EN,
+	GRF_DPHY_CSIPHY_LANE_SEL,
+	GRF_DPHY_CIF_CSIPHY_SEL,
+	GRF_DPHY_ISP_CSIPHY_SEL,
 };
 
 struct dphy_reg {
@@ -117,6 +131,11 @@
 	[GRF_DPHY_CSIPHY_FORCERXMODE] = PHY_REG(RK3568_GRF_VI_CON0, 4, 0),
 	[GRF_DPHY_CSIPHY_DATALANE_EN] = PHY_REG(RK3568_GRF_VI_CON0, 4, 4),
 	[GRF_DPHY_CSIPHY_CLKLANE_EN] = PHY_REG(RK3568_GRF_VI_CON0, 1, 8),
+	[GRF_DPHY_CSIPHY_DATALANE1_EN] = PHY_REG(RK3568_GRF_VI_CON0, 2, 6),
+	[GRF_DPHY_CSIPHY_CLKLANE1_EN] = PHY_REG(RK3568_GRF_VI_CON0, 1, 10),
+	[GRF_DPHY_CSIPHY_LANE_SEL] = PHY_REG(RK3568_GRF_VI_CON1, 1, 7),
+	[GRF_DPHY_CIF_CSIPHY_SEL] = PHY_REG(RK3568_GRF_VI_CON1, 1, 11),
+	[GRF_DPHY_ISP_CSIPHY_SEL] = PHY_REG(RK3568_GRF_VI_CON1, 1, 12),
 };
 
 static const struct dphy_reg rk3588_grf_dphy_regs[] = {
@@ -151,6 +170,8 @@
 	const struct dphy_drv_data *drv_data;
 	struct phy_configure_opts_mipi_dphy config;
 	u8 hsfreq;
+	/* first physical data lane: 0, or 2 for the split-mode upper pair */
+	u8 lane_offset;
 };
 
 static inline void write_grf_reg(struct rockchip_inno_csidphy *priv,
@@ -267,7 +288,8 @@
 		       priv->phy_base + drv_data->pwrctl_offset);
 
 	/* set data lane num and enable clock lane */
-	val = FIELD_PREP(CSIDPHY_CTRL_LANE_ENABLE_MASK, GENMASK(priv->config.lanes - 1, 0)) |
+	val = FIELD_PREP(CSIDPHY_CTRL_LANE_ENABLE_MASK,
+			 GENMASK(priv->config.lanes - 1, 0) << priv->lane_offset) |
 	      FIELD_PREP(CSIDPHY_CTRL_LANE_ENABLE_CK, 1) |
 	      FIELD_PREP(CSIDPHY_CTRL_LANE_ENABLE_UNDEFINED, 1);
 	writel(val, priv->phy_base + CSIDPHY_CTRL_LANE_ENABLE);
@@ -278,10 +300,15 @@
 		       priv->phy_base + drv_data->pwrctl_offset);
 	usleep_range(500, 1000);
 
-	/* Reset dphy digital part */
-	writel(CSIDPHY_CTRL_DIG_RST_UNDEFINED,
-	       priv->phy_base + CSIDPHY_CTRL_DIG_RST);
-	writel(CSIDPHY_CTRL_DIG_RST_UNDEFINED + CSIDPHY_CTRL_DIG_RST_RESET,
+	/*
+	 * Reset dphy digital part. The upper lane pair only receives with
+	 * the PHY in dual (split) mode; the bit is latched by this reset.
+	 */
+	val = CSIDPHY_CTRL_DIG_RST_UNDEFINED;
+	if (priv->lane_offset)
+		val |= CSIDPHY_CTRL_DIG_RST_DUAL_MODE;
+	writel(val, priv->phy_base + CSIDPHY_CTRL_DIG_RST);
+	writel(val | CSIDPHY_CTRL_DIG_RST_RESET,
 	       priv->phy_base + CSIDPHY_CTRL_DIG_RST);
 
 	/* not into receive mode/wait stopstate */
@@ -291,22 +318,38 @@
 	if (data_rate_mbps > 1500 && drv_data->calib_offset >= 0) {
 		writel(CSIDPHY_CALIB_EN,
 		       priv->phy_base + drv_data->calib_offset +
-					CSIDPHY_CLK_CALIB_EN);
+					(priv->lane_offset ? CSIDPHY_CLK1_CALIB_EN :
+							     CSIDPHY_CLK_CALIB_EN));
 		for (i = 0; i < priv->config.lanes; i++)
 			writel(CSIDPHY_CALIB_EN,
 			       priv->phy_base + drv_data->calib_offset +
-						CSIDPHY_LANE_CALIB_EN(i));
+					CSIDPHY_LANE_CALIB_EN(priv->lane_offset + i));
 	}
 
 	rockchip_inno_csidphy_ths_settle(priv, priv->hsfreq,
-					 CSIDPHY_CLK_THS_SETTLE);
+					 priv->lane_offset ? CSIDPHY_CLK1_THS_SETTLE :
+							     CSIDPHY_CLK_THS_SETTLE);
 	for (i = 0; i < priv->config.lanes; i++)
 		rockchip_inno_csidphy_ths_settle(priv, priv->hsfreq,
-						 CSIDPHY_LANE_THS_SETTLE(i));
+				CSIDPHY_LANE_THS_SETTLE(priv->lane_offset + i));
 
-	write_grf_reg(priv, GRF_DPHY_CSIPHY_CLKLANE_EN, 0x1);
-	write_grf_reg(priv, GRF_DPHY_CSIPHY_DATALANE_EN,
-		      GENMASK(priv->config.lanes - 1, 0));
+	if (priv->lane_offset) {
+		/*
+		 * Split mode, upper pair: lanes 2 and 3 clocked from the
+		 * second clock lane, routed to the CIF (VICAP) receiver.
+		 */
+		write_grf_reg(priv, GRF_DPHY_CSIPHY_LANE_SEL, 0x1);
+		write_grf_reg(priv, GRF_DPHY_CIF_CSIPHY_SEL, 0x1);
+		write_grf_reg(priv, GRF_DPHY_ISP_CSIPHY_SEL, 0x0);
+		write_grf_reg(priv, GRF_DPHY_CSIPHY_CLKLANE1_EN, 0x1);
+		write_grf_reg(priv, GRF_DPHY_CSIPHY_DATALANE1_EN,
+			      GENMASK(priv->config.lanes - 1, 0));
+	} else {
+		write_grf_reg(priv, GRF_DPHY_CSIPHY_LANE_SEL, 0x0);
+		write_grf_reg(priv, GRF_DPHY_CSIPHY_CLKLANE_EN, 0x1);
+		write_grf_reg(priv, GRF_DPHY_CSIPHY_DATALANE_EN,
+			      GENMASK(priv->config.lanes - 1, 0));
+	}
 
 	return 0;
 }
@@ -350,6 +393,35 @@
 	return 0;
 }
 
+/*
+ * With #phy-cells = <1>, the cell selects the physical lane pair: 0 for
+ * lanes 0-1 (or all four in full mode), 1 for lanes 2-3 with the second
+ * clock lane. Only SoCs whose GRF describes the split mode accept 1.
+ */
+static struct phy *rockchip_inno_csidphy_xlate(struct device *dev,
+					       const struct of_phandle_args *args)
+{
+	struct rockchip_inno_csidphy *priv = dev_get_drvdata(dev);
+	struct phy *phy = of_phy_simple_xlate(dev, args);
+	u32 pair = args->args_count ? args->args[0] : 0;
+
+	if (IS_ERR(phy))
+		return phy;
+
+	if (pair > 1)
+		return ERR_PTR(-EINVAL);
+
+	if (pair &&
+	    !priv->drv_data->grf_regs[GRF_DPHY_CSIPHY_DATALANE1_EN].valid) {
+		dev_err(dev, "split mode is not supported on this SoC\n");
+		return ERR_PTR(-EINVAL);
+	}
+
+	priv->lane_offset = pair ? 2 : 0;
+
+	return phy;
+}
+
 static const struct phy_ops rockchip_inno_csidphy_ops = {
 	.power_on	= rockchip_inno_csidphy_power_on,
 	.power_off	= rockchip_inno_csidphy_power_off,
@@ -503,7 +575,8 @@
 
 	phy_set_drvdata(phy, priv);
 
-	phy_provider = devm_of_phy_provider_register(dev, of_phy_simple_xlate);
+	phy_provider = devm_of_phy_provider_register(dev,
+						     rockchip_inno_csidphy_xlate);
 	if (IS_ERR(phy_provider)) {
 		dev_err(dev, "failed to register phy provider\n");
 		return PTR_ERR(phy_provider);

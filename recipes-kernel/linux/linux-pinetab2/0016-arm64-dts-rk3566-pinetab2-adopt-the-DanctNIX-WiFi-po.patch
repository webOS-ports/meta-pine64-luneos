From 631efd27c0e078edd3510839c4d043bbd30361a8 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Wed, 9 Sep 2026 13:41:22 +0200
Subject: [PATCH 16/26] arm64: dts: rk3566-pinetab2: adopt the DanctNIX WiFi
 power arrangement

The BES2600 enumerates on SDIO and its firmware downloads and starts, but the
chip then stops answering entirely - 600 consecutive CMD52 polls over 60s all
return -110 with no response:

    firmware is downloaded successfully and is already running
    bes2600 read dpd cali data.
    dpd wait: 20 polls, ret=-110 status=0x00
    ...
    dpd wait: 560 polls, ret=-110 status=0x00
    wait dpd data ready failed:-110

postmarketOS ships this board on kernel 7.1.8 with the DanctNIX patch set
(codeberg.org/DanctNIX/linux-pinetab2, v7.1.8-danctnix1), where the very same
vendor driver works - their bes_fw.c is byte-identical to ours, including the
DPD wait loop and its -84-only error tolerance. So the driver is not what
differs; the chip simply answers on their setup. What differs is how the
board powers it.

DanctNIX, for a v2.0 board:

    vcc_wl        regulator-fixed, gpio0 RK_PA0, enable-active-high
    sdio_pwrseq   mmc-pwrseq-simple, reset gpio3 RK_PD2 ACTIVE_LOW,  200ms
    sdio_pwrkey   mmc-pwrseq-simple, reset gpio3 RK_PD3 ACTIVE_HIGH, 500ms
    &sdmmc1       vmmc-supply = <&vcc_wl>
                  mmc-pwrseq = <&sdio_pwrseq &sdio_pwrkey>
                  sd-uhs-sdr104

megi's tree instead has a custom mmc-pwrseq-bes driving pwrkey, pwren and
reset from one node, with the reset line at the opposite polarity
(ACTIVE_HIGH), an always-on wl_reg whose gpio/enable-active-high are
commented out, and sd-uhs-sdr104 commented out. His own note on that node
reads "todo, use this + simple pwrseq instead of custom pwrseq driver", so
this is a stopgap he intends to replace with exactly the arrangement below.

Three details matter and are easy to get wrong - an earlier attempt at this
patch got all three wrong and left the chip completely unpowered
("mmc2: Failed to initialize a non-removable card"):

  - vcc_wl must carry gpio + enable-active-high. The base dtsi does not have
    them; they come from an &vcc_wl override in the v2.0 board file.

  - sdio_pwrkey must exist. mmc_pwrseq_alloc() only ever resolves phandle
    index 0, so the core never sequences it - but mmc-pwrseq-simple still
    probes the node and takes its reset GPIO as GPIOD_OUT_HIGH, which is what
    asserts the chip's power-key on RK_PD3. Drop the node and that assertion
    is silently lost.

  - the reset line is ACTIVE_LOW here, not ACTIVE_HIGH.

sd-uhs-sdr104 is restored to match the reference. On its own it changes
nothing (the card never completes the 1.8V handshake, so the host falls back
to high speed either way), but there is no reason to differ from a
configuration that is known to work.

Upstream-Status: Inappropriate [board configuration]
Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
---
 .../dts/rockchip/rk3566-pinetab2-v2.0.dts     | 48 ++++++++++++-------
 .../boot/dts/rockchip/rk3566-pinetab2.dtsi    |  2 +-
 2 files changed, 31 insertions(+), 19 deletions(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk3566-pinetab2-v2.0.dts b/arch/arm64/boot/dts/rockchip/rk3566-pinetab2-v2.0.dts
index ad421edeb39c..530961ed2a35 100644
--- a/arch/arm64/boot/dts/rockchip/rk3566-pinetab2-v2.0.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3566-pinetab2-v2.0.dts
@@ -8,30 +8,42 @@ / {
 	model = "Pine64 PineTab2 v2.0";
 	compatible = "pine64,pinetab2-v2.0", "pine64,pinetab2", "rockchip,rk3566";
 
-	// todo, use this + simple pwrseq instead of custom pwrseq driver
-	wl_reg: wl-regulator {
+	/* Power arrangement taken from the DanctNIX v7.1.8 PineTab2 tree, which
+	 * is a working reference for this exact board. */
+	vcc_wl: vcc-wl {
 		compatible = "regulator-fixed";
-//		enable-active-high;
-//		gpio = <&gpio0 RK_PA0 GPIO_ACTIVE_HIGH>;
-//		pinctrl-names = "default";
-//		pinctrl-0 = <&wifi_pwren>;
-		regulator-name = "wl_reg";
+		enable-active-high;
+		gpio = <&gpio0 RK_PA0 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&wifi_pwren>;
+		regulator-name = "vcc_wl";
 		regulator-min-microvolt = <3300000>;
 		regulator-max-microvolt = <3300000>;
-		vin-supply = <&vcc_sys>;
-//		startup-delay-us = <100000>;
-//		off-on-delay-us = <100000>;
+		vin-supply = <&vcc3v3_sys>;
+
+		regulator-state-mem {
+			regulator-off-in-suspend;
+		};
+	};
+
+	sdio_pwrseq: sdio-pwrseq {
+		compatible = "mmc-pwrseq-simple";
+		clocks = <&rk817 1>;
+		clock-names = "ext_clock";
+		pinctrl-names = "default";
+		pinctrl-0 = <&wifi_reset>;
+		reset-gpios = <&gpio3 RK_PD2 GPIO_ACTIVE_LOW>;
+		post-power-on-delay-ms = <200>;
 	};
 
-	wl_pwrseq: wl-pwrseq {
-		compatible = "mmc-pwrseq-bes";
+	sdio_pwrkey: sdio-pwrkey {
+		compatible = "mmc-pwrseq-simple";
 		clocks = <&rk817 1>;
 		clock-names = "ext_clock";
 		pinctrl-names = "default";
-		pinctrl-0 = <&wifi_pwrkey &wifi_reset &wifi_pwren>;
-		pwrkey-gpios = <&gpio3 RK_PD3 GPIO_ACTIVE_HIGH>;
-		pwren-gpios = <&gpio0 RK_PA0 GPIO_ACTIVE_HIGH>;
-		reset-gpios = <&gpio3 RK_PD2 GPIO_ACTIVE_HIGH>;
+		pinctrl-0 = <&wifi_pwrkey>;
+		reset-gpios = <&gpio3 RK_PD3 GPIO_ACTIVE_HIGH>;
+		post-power-on-delay-ms = <500>;
 	};
 };
 
@@ -88,8 +100,8 @@ wifi_pwren: wifi-pwren {
 };
 
 &sdmmc1 {
-	vmmc-supply = <&wl_reg>;
-	mmc-pwrseq = <&wl_pwrseq>;
+	vmmc-supply = <&vcc_wl>;
+	mmc-pwrseq = <&sdio_pwrseq &sdio_pwrkey>;
 	#address-cells = <1>;
 	#size-cells = <0>;
 
diff --git a/arch/arm64/boot/dts/rockchip/rk3566-pinetab2.dtsi b/arch/arm64/boot/dts/rockchip/rk3566-pinetab2.dtsi
index 32f37a0e3100..05429c0be046 100644
--- a/arch/arm64/boot/dts/rockchip/rk3566-pinetab2.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3566-pinetab2.dtsi
@@ -959,7 +959,7 @@ &sdmmc1 {
 	pinctrl-0 = <&sdmmc1_bus4
 		     &sdmmc1_cmd
 		     &sdmmc1_clk>;
-	//sd-uhs-sdr104;
+	sd-uhs-sdr104;
 	vqmmc-supply = <&vcca1v8_pmu>;
 	status = "okay";
 };
-- 

From de45954a08c888992ecab0ba057d51cb9646082f Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Fri, 18 Sep 2026 00:00:00 +0200
Subject: [PATCH 02/26] media: i2c: ov5648: do not refuse analogue gain while
 AGC reads enabled

The V4L2_CID_ANALOGUE_GAIN handler turns AGC off in hardware and then calls
ov5648_gain_configure(), which refuses with -EINVAL whenever the AUTOGAIN
control still reads as enabled - and it does, because writing the manual-AGC
register does not change the control's value.

AUTOGAIN defaults to enabled, so __v4l2_ctrl_handler_setup() fails as soon as
it applies the analogue gain during runtime resume. That makes every resume
fail with -EINVAL, which surfaces far away as

  rockchip-cif fdfe0000.video-capture: enable streams 0:0x1 failed: -22

with nothing logged by the sensor itself.

Split the register write out of ov5648_gain_configure() and use it directly
from the analogue gain path, which has just disabled AGC itself.

Fixes the analogue gain control added for libcamera.

Upstream-Status: Pending

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
---
 drivers/media/i2c/ov5648.c | 23 +++++++++++++++++------
 1 file changed, 17 insertions(+), 6 deletions(-)

diff --git a/drivers/media/i2c/ov5648.c b/drivers/media/i2c/ov5648.c
index b8363d799d95..81e0e5a3277e 100644
--- a/drivers/media/i2c/ov5648.c
+++ b/drivers/media/i2c/ov5648.c
@@ -1616,14 +1616,10 @@ static int ov5648_gain_auto_configure(struct ov5648_sensor *sensor, bool enable)
 				  enable ? 0 : OV5648_MANUAL_CTRL_AGC_MANUAL_EN);
 }
 
-static int ov5648_gain_configure(struct ov5648_sensor *sensor, u32 gain)
+static int ov5648_gain_write(struct ov5648_sensor *sensor, u32 gain)
 {
-	struct ov5648_ctrls *ctrls = &sensor->ctrls;
 	int ret;
 
-	if (ctrls->gain_auto->val)
-		return -EINVAL;
-
 	ret = ov5648_write(sensor, OV5648_GAIN_CTRL_H_REG,
 			   OV5648_GAIN_CTRL_H(gain));
 	if (ret)
@@ -1633,6 +1629,16 @@ static int ov5648_gain_configure(struct ov5648_sensor *sensor, u32 gain)
 			    OV5648_GAIN_CTRL_L(gain));
 }
 
+static int ov5648_gain_configure(struct ov5648_sensor *sensor, u32 gain)
+{
+	struct ov5648_ctrls *ctrls = &sensor->ctrls;
+
+	if (ctrls->gain_auto->val)
+		return -EINVAL;
+
+	return ov5648_gain_write(sensor, gain);
+}
+
 static int ov5648_gain_value(struct ov5648_sensor *sensor, u32 *gain)
 {
 	u8 gain_h = 0, gain_l = 0;
@@ -2061,7 +2067,12 @@ static int ov5648_s_ctrl(struct v4l2_ctrl *ctrl)
 		if (ret)
 			return ret;
 
-		return ov5648_gain_configure(sensor, ctrl->val);
+		/*
+		 * AGC has just been turned off in hardware, but the AUTOGAIN
+		 * control still reads as enabled, so go straight to the
+		 * registers rather than through ov5648_gain_configure().
+		 */
+		return ov5648_gain_write(sensor, ctrl->val);
 	case V4L2_CID_VBLANK:
 		return ov5648_vts_configure(sensor, sensor->state.mode,
 					    sensor->state.mode->output_size_y +
-- 
